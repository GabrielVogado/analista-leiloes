<style>
:root{
  --bg:#f3f5f7;--panel:#fff;--ink:#18212b;--muted:#5b6876;--line:#dbe1e7;--soft:#e9eef3;
  --accent:#1f5f8b;--accent-soft:#e3eef6;
  --ok:#1e7a46;--ok-bg:#e2f3e8;--warn:#9a6700;--warn-bg:#fbf0d6;--bad:#b3261e;--bad-bg:#fbe4e2;--info-bg:#eef1f4;
  --f-body:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;--f-mono:"Cascadia Mono",Consolas,ui-monospace,monospace;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#10161c;--panel:#18212a;--ink:#e6ecf1;--muted:#9aa8b5;--line:#2b3743;--soft:#212c37;
  --accent:#7fb6de;--accent-soft:#1c3346;
  --ok:#6fd39a;--ok-bg:#16301f;--warn:#f0c15a;--warn-bg:#352a10;--bad:#ff8f86;--bad-bg:#3a1a18;--info-bg:#1d2630;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5;padding:20px 16px 48px}
.wrap{max-width:1180px;margin:0 auto;display:grid;gap:20px}
h1,h2,h3{margin:0;line-height:1.2;text-wrap:balance}
h1{font-size:clamp(1.4rem,3vw,2rem);font-weight:800}
h2{font-size:1.15rem;font-weight:700}
h3{font-size:.98rem;font-weight:700}
p{margin:0}
a{color:var(--accent)}
code{font-family:var(--f-mono);font-size:.9em}
.num,.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.muted{color:var(--muted)} .small{font-size:.85rem}
.eyebrow{font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);font-weight:600}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:18px;display:grid;gap:12px;min-width:0}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px}
.pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:2px 10px;font-size:.75rem;font-weight:600;white-space:nowrap}
.pill::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.s-ok{color:var(--ok);background:var(--ok-bg)} .s-warn{color:var(--warn);background:var(--warn-bg)}
.s-bad{color:var(--bad);background:var(--bad-bg)} .s-info{color:var(--muted);background:var(--info-bg)}
.tag{font-family:var(--f-mono);font-size:.66rem;padding:1px 6px;border-radius:4px;font-weight:600;white-space:nowrap}
.t-C{color:var(--ok);background:var(--ok-bg)} .t-E{color:var(--warn);background:var(--warn-bg)}
.t-I{color:var(--accent);background:var(--accent-soft)} .t-X{color:var(--bad);background:var(--bad-bg)}
.t-N{color:var(--muted);background:var(--info-bg)}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.86rem}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:.7rem;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:600;white-space:nowrap}
td.r,th.r{text-align:right}
td.num{white-space:nowrap}
ul.lista{margin:0;padding-left:18px;display:grid;gap:6px}
label{display:grid;gap:4px;font-size:.85rem;font-weight:600;align-content:start}
label .muted{font-weight:400}
input,select,textarea{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:6px;background:var(--panel);color:var(--ink);min-width:0;width:100%}
input:focus-visible,select:focus-visible,textarea:focus-visible,a:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
button,.btn{font:inherit;font-weight:600;background:var(--accent);color:var(--panel);border:0;border-radius:8px;padding:10px 18px;cursor:pointer;text-decoration:none;display:inline-block}
.btn.sec{background:var(--soft);color:var(--ink)}
.campos{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
fieldset{border:1px solid var(--line);border-radius:10px;padding:14px;display:grid;gap:12px;margin:0;min-width:0}
legend{font-weight:700;padding:0 6px}
</style>
